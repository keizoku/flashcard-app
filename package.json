{
  "name": "flashcard-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/migrate.mjs && next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "node scripts/migrate.mjs && next start",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "node tools/test-runner/server.mjs",
    "test:e2e": "playwright test",
    "test:report": "node tools/report/make-report.mjs"
  },
  "dependencies": {
    "next": "^15.3.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "wink-lemmatizer": "^3.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vitest": "^5.1.0"
  }
}
